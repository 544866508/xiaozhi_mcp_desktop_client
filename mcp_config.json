        "instructions": "设备说明",
        "cmd": {
          "rawCmdList": [
            {"cmdName": "命令名称1", "rawData": [2333, 2444]},
            {"cmdName": "命令名称2", "rawData": [2555, 2666]},
            {"cmdName": "命令名称3", "rawData": [2777, 2888]}
          ],
          "seqCmdList": [
            {
              "cmdName": "组合命令名称1",
              "steps": [
                {"cmdName": "命令名称1", "delayAfter": 600000},
                {"cmdName": "命令名称2", "delayAfter": 0}
              ]
            },
            {
              "cmdName": "组合命令名称2",
              "steps": [
                {"cmdName": "命令名称1", "delayAfter": 600000},
                {"cmdName": "命令名称2", "delayAfter": 1800000},
                {"cmdName": "命令名称3", "delayAfter": 0}
              ]
            }
          ]
        }
      }
    }
}
