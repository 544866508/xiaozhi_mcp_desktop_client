{
  "mcpServers": {
    "local-stdio-calculator": {
      "type": "stdio",
      "command": "python",
      "description": "小智自带测试MCP（计算器）",
      "args": ["-m", "local_mcp.calculator"],
      "disabled": true
    },
"MCP_NAME": {
    "disabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["-m", "local_mcp.CONTROLLER_NAME"],
